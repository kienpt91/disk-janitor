{
  "name": "disk-janitor",
  "version": "0.1.0",
  "description": "Disk cleanup that coding agents can use safely: read-only scan, reviewable plan, human-only approval, quarantine with undo.",
  "keywords": [
    "disk-cleanup",
    "coding-agents",
    "mcp",
    "node_modules",
    "cache",
    "quarantine",
    "safety"
  ],
  "license": "MIT",
  "author": "Kien Phan",
  "type": "module",
  "bin": {
    "disk-janitor": "dist/infrastructure/cli/bin.js",
    "disk-janitor-mcp": "dist/infrastructure/mcp/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/infrastructure/mcp/server.d.ts",
      "default": "./dist/infrastructure/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run test/domain",
    "test:application": "vitest run test/application",
    "test:infrastructure": "vitest run test/infrastructure",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:architecture": "vitest run test/architecture.test.ts",
    "test:layers": "npm run test:architecture && npm run test:domain && npm run test:application && npm run test:infrastructure && npm run test:integration && npm run test:e2e",
    "coverage": "vitest run --coverage && node scripts/coverage-summary.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
